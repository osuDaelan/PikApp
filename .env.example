# Copy to .env.local for localhost development, then use your Firebase Web app config.
# These values identify the public client app; Vite includes them in the browser bundle.
# Never put service-account JSON, private keys, or OAuth client secrets here.
# See docs/GOOGLE_SIGN_IN.md for Firebase and GitHub Pages setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional private feedback. Public form endpoint, not a secret/API key.
# Create your own Formspree form, enable spam checks, and see docs/FEEDBACK.md.
VITE_FEEDBACK_ENDPOINT=
